# Sentinel Gujarat — environment template
# Copy to .env and set SANDBOX_HOST to your sandbox machine.

SANDBOX_HOST=localhost

# Backend overrides (optional when using docker-compose)
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_gujarat
# REDIS_URL=redis://localhost:6379/0
# SANDBOX_INGEST_URL=http://localhost/api/ingest
# SANDBOX_WHEP_BASE=http://localhost:8889/stream
# SANDBOX_HLS_BASE=http://localhost/live/stream
# CATALOG_REFRESH_SECONDS=60
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
