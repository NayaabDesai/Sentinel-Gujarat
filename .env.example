# ==============================================================================
# SENTINEL GUJARAT — ENVIRONMENT TEMPLATE
# Copy to .env and fill in your real values.
# sentinel.bat will copy it automatically if .env is missing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SANDBOX GATEWAY  (cctv.corp8.cloud)
#    Register at https://cctv.corp8.cloud to get your access password.
#    Camera IDs run cam01 … cam30; always read from cameras.json, never hardcode.
# ------------------------------------------------------------------------------
SANDBOX_HOST=cctv.corp8.cloud

# Camera catalog endpoint (requires HTTP Basic Auth with email + password below)
SANDBOX_INGEST_URL=https://cctv.corp8.cloud/cameras.json

# HLS (CDN — works on any network, no credential in URL)
SANDBOX_HLS_BASE=https://cctv.corp8.cloud

# WebRTC/WHEP  — direct public IP, credentials embedded in URL by the app
SANDBOX_WHEP_BASE=http://103.250.160.189:8889/stream

# RTSP — direct public IP, TCP only, credentials embedded in URL by the app
SANDBOX_RTSP_HOST=103.250.160.189:8554

# Your registered credentials (@ in email is percent-encoded automatically)
SANDBOX_EMAIL=your-email@example.com
SANDBOX_PASSWORD=your-access-password

# How often (seconds) the catalog-sync worker polls cameras.json
# Keep AUTO_SYNC=false — sandbox allows only ONE web session per IP.
CATALOG_AUTO_SYNC=false
CATALOG_REFRESH_SECONDS=3600

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sentinel_db
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. BACKEND & API SETTINGS
# ------------------------------------------------------------------------------
API_V1_STR=/api/v1
PROJECT_NAME=Sentinel Gujarat Registry
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STREAM_IDLE_SECONDS=120

# ------------------------------------------------------------------------------
# 4. CAPTURE WORKER & OPENCV RULES
# ------------------------------------------------------------------------------
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp
ACTIVE_POLL_SECONDS=5

# ------------------------------------------------------------------------------
# 5. FRONTEND
# ------------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
VITE_SANDBOX_HOST=cctv.corp8.cloud
